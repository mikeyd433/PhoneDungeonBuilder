<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- Recordings stream from the story's public audio links. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Recording takes on the phone. Asked for the first time ● REC is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Parked-only Android Auto game. Do NOT add distractionOptimized metadata. -->
    <application
        android:name=".JackieApp"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Phone launcher entry: the keypad. No CAR_LAUNCHER here. -->
        <activity
            android:name=".ui.PhoneActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden"
            android:theme="@style/Theme.App.Phone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The terminal itself, on the car display while parked (also "Preview on phone"). -->
        <activity
            android:name=".ui.CarActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden"
            android:theme="@style/Theme.App.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
